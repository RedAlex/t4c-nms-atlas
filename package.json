{
  "name": "t4c-nms-atlas",
  "version": "0.1.0",
  "description": "Carte interactive telechargeable T4C NMS Revolution",
  "main": "electron/main.cjs",
  "author": "Atlas NMS Revolution contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedAlex/t4c-nms-atlas"
  },
  "scripts": {
    "dev": "electron .",
    "build:win": "node scripts/build-win.cjs",
    "check-updates": "node scripts/check-updates.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,html,css,md}\" --ignore-path .gitignore",
    "docs": "jsdoc -c jsdoc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changelog": "node scripts/changelog.mjs",
    "release:patch": "npm version patch && node scripts/changelog.mjs",
    "release:minor": "npm version minor && node scripts/changelog.mjs",
    "release:major": "npm version major && node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "archiver": "^7.0.1",
    "electron": "^41.4.0",
    "eslint": "^8.56.0",
    "happy-dom": "^20.9.0",
    "jsdoc": "^4.0.4",
    "prettier": "^3.1.1",
    "vitest": "^3.2.0"
  }
}
